{
  "info": {
    "name": "Tixxgo API",
    "description": "API collection for the Tixxgo travel platform backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Flights",
      "item": [
        {
          "name": "Search Flights",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"AMD\",\n  \"destination\": \"DEL\",\n  \"departureDate\": \"2026-10-15\",\n  \"adults\": 1,\n  \"cabinClass\": \"ECONOMY\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/flights/search",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "flights",
                "search"
              ]
            }
          }
        },
        {
          "name": "Revalidate Fare",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tixxgoResultId\": \"{{tixxgoResultId}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/flights/revalidate",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "flights",
                "revalidate"
              ]
            }
          }
        }
      ]
    },
